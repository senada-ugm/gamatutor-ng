# ==============================================================================
# DOCKER COMPOSE / DOKPLOY UNIFIED ENVIRONMENT TEMPLATE
#
# Auto-generated from individual app contracts (apps/*/.env.example).
# DO NOT EDIT THIS FILE DIRECTLY.
# Edit the respective app's .env.example and run: pnpm env:compose
# ==============================================================================
# ------------------------------------------------------------------------------
# [apps/api] Backend Core, Secrets & Config (Passed to 'api' service)
# Source: apps/api/.env.example
# ------------------------------------------------------------------------------
# --- API Core ---
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_api
DATABASE_POOL_MAX=10
BETTER_AUTH_SECRET=development_secret_only_change_in_production_32chars
BETTER_AUTH_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000,http://localhost:3030
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

# --- Email (SMTP for Mailpit localhost:1025, or Resend in production) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=LMS <onboarding@resend.dev>

# --- Storage (S3-compatible: RustFS / MinIO / Cloudflare R2 / AWS S3) ---
# Unset S3_BUCKET falls back to local disk storage in apps/api/storage/uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true
UPLOAD_ORPHAN_TTL_HOURS=24
UPLOAD_STORAGE_DIR=
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000

# --- Google OAuth (inert until both set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Stripe-compatible; unset SECRET_KEY = manual transfer only) ---
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_BASE=https://api.stripe.com
PAYMENT_CURRENCY=idr
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# --- PII Encryption (KTP/BPJS at rest; 32-byte secret required in prod) ---
PII_ENCRYPTION_KEY=

# --- Attendance ---
BUSINESS_TIMEZONE=Asia/Jakarta
ATTENDANCE_CODE_EXPIRY_SECONDS=300

# --- Redis (shared rate-limiting store) ---
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# [apps/app] Vite SPA (Passed as build args to 'app' service)
# Source: apps/app/.env.example
# ------------------------------------------------------------------------------
# LMS Authenticated Web App (React SPA)
# Backend API Base URL
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# [apps/web] Marketing SSR (Passed to 'web' service)
# Source: apps/web/.env.example
# ------------------------------------------------------------------------------
# LMS Marketing & Public Site (TanStack Start SSR)
# Backend API Base URL
VITE_API_URL=http://localhost:8000
# Authenticated App Origin (for redirects to apps/app)
VITE_APP_ORIGIN=http://localhost:3030
