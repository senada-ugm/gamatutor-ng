apps/web/src/routeTree.gen.ts

# --- Vendored: shadcn registry output ---
# Already excluded from lint (packages/ui/eslint.config.ts) and typecheck
# (packages/ui/tsconfig.json) under the same never-hand-edit rule — an
# `shadcn add --overwrite` would discard any reformatting anyway.
packages/ui/src/components/

# --- Runtime data ---
apps/api/storage/

# --- Prose ---
# Every config key here (printWidth, semi, singleQuote, trailingComma) is
# a code concern. Prettier's markdown printer meanwhile de-indents the
# continuation lines of these hand-wrapped docs — it reads a wrapped
# `apps/api/src/modules/.../service.ts` path inside a list item as a lazy
# continuation and flattens it to column 0 — and rewrites *emphasis* as
# _emphasis_. Formatting prose is not what this config is for.
*.md
