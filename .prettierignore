# Patterns here resolve relative to THIS file, not the cwd — which is why
# every package's format script passes `--ignore-path ../../.prettierignore`.
# Prettier only auto-discovers an ignore file in the directory it runs
# from, so without that flag a package-level `prettier --write` sees no
# ignore list at all and happily rewrites everything below.

# --- Build output and caches ---
dist/
build/
