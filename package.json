{
  "name": "lms",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:contracts": "pnpm --filter @workspace/contracts build",
    "dev": "turbo dev",
    "dev:api": "pnpm --filter api dev",
    "env:compose": "node scripts/generate-compose-env.mjs",
    "env:compose:check": "node scripts/generate-compose-env.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "test:api": "node tests/api/run.mjs",
    "typecheck": "turbo typecheck",
    "validate": "turbo validate"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
