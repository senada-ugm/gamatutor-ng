{
  "name": "gamatutor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:standalone": "tsx tools/build-standalone.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm typecheck:isolation && pnpm test",
    "typecheck:isolation": "tsc -p packages/course-schema/tsconfig.json && tsc -p packages/tracking/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@gamatutor/course-player": "workspace:*",
    "@gamatutor/course-schema": "workspace:*",
    "@gamatutor/tracking": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
